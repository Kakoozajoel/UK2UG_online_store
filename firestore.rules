rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Districts
    match /districts/{districtId} {
      allow read, write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Customer Profiles - Allow reading and writing customer records so signups & sync succeed
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Customer Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Custom Sourcing Imports
    match /imports/{importId} {
      allow read, write: if true;
    }

    // Customer Support Messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Storefront Configuration (Hero banner, visual assets)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Customer Complaints
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


